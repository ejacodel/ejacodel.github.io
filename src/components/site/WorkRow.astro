---
/** A project row: name first, big enough to read at a glance. Hovering inverts it and reveals the cover. */
import Pic from '../media/Pic.astro';
import { findImage } from '../../lib/media';
const { entry } = Astro.props;
const d = entry.data;
const hasCover = !!(await findImage(d.cover));
---
<a class="row" href={`/work/${entry.id}/`} data-disciplines={d.disciplines.join(',')}>
  <span class="t-dot n">{String(d.order).padStart(2, '0')}</span>
  <span class="main">
    <span class="t-display t-xl ttl">{d.title}</span>
    <span class="short">{d.short}</span>
  </span>
  <span class="meta">
    <span class="t-label">{d.context}</span>
    <span class="t-label soft">{d.years} / {d.status}</span>
    <ul class="tags">{d.disciplines.map((t: string) => <li>{t}</li>)}</ul>
  </span>
  <span class:list={['thumb', { empty: !hasCover }]} aria-hidden="true">
    {hasCover ? <Pic src={d.cover} alt="" sizes="(max-width: 800px) 100vw, 26vw" /> : <span class="t-dot">{String(d.order).padStart(2, '0')}</span>}
  </span>
</a>
<style>
  .row { display: grid; grid-template-columns: clamp(50px, 7vw, 120px) minmax(0, 6fr) minmax(170px, 2fr) clamp(180px, 22vw, 360px); gap: var(--g); padding-block: clamp(14px, 1.6vw, 24px); border-top: var(--rule) solid var(--line); text-decoration: none; align-items: start; position: relative; }
  .row:hover { background: var(--fg); color: var(--bg); box-shadow: calc(-1 * var(--g)) 0 0 var(--fg), var(--g) 0 0 var(--fg); --soft: currentColor; }
  .n { font-size: clamp(1.8rem, 4vw, 4.5rem); }
  .main { display: flex; flex-direction: column; gap: .7rem; }
  .ttl { font-size: clamp(2.3rem, 5.6vw, 6.4rem); }
  .short { max-width: 52ch; font-size: 1rem; line-height: 1.35; }
  .meta { display: flex; flex-direction: column; gap: .4rem; padding-top: .3rem; }
  .thumb { display: block; aspect-ratio: 4/3; background: #0a0a0a; overflow: hidden; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); }
  .row:hover .thumb :global(img) { filter: none; }
  .thumb.empty { display: grid; place-items: center; background: #aeaca7 url("/textures/concrete-light.webp"); color: #0a0a0a; font-size: 3rem; }
  @media (max-width: 1000px) {
    .row { grid-template-columns: clamp(44px, 9vw, 80px) minmax(0, 1fr); }
    .meta { grid-column: 2; }
    .thumb { grid-column: 1 / -1; aspect-ratio: 16/9; }
    .thumb.empty { display: none; }
    .thumb :global(img) { filter: none; }
  }
</style>
