---
/**
 * The camera-matched transition from CAD to the real machine.
 * Two clips of equal length and framing play in sync. Scrolling sweeps the divider across
 * the frame; the visitor can then grab it and compare freely.
 *   <DesignToReality render="robot/d2r-render.mp4" real="robot/d2r-real.mp4" />
 * Recipe for matching the two cameras: docs/MEDIA.md
 */
import Wipe from './Wipe.astro';
import StandinMachine from './StandinMachine.astro';
import { isDev, mediaUrl, publicExists } from '../../lib/media';
interface Props { render: string; real: string; caption?: string; labelA?: string; labelB?: string; }
const { render, real, caption, labelA = 'Design / CAD render', labelB = 'Reality / footage' } = Astro.props;
const ready = publicExists(render) && publicExists(real);
---
<div class="pin" data-pin>
  <div class="stage">
    <Wipe mode="scroll" start={1} fill labelA={labelA} labelB={labelB}>
      {ready
        ? <video slot="a" src={mediaUrl(render)} muted loop autoplay playsinline preload="auto"></video>
        : <div slot="a" class="fillbox"><StandinMachine variant="cad" /></div>}
      {ready
        ? <video slot="b" src={mediaUrl(real)} muted loop autoplay playsinline preload="auto"></video>
        : <div slot="b" class="fillbox"><StandinMachine variant="real" /></div>}
    </Wipe>
    {!ready && <span class="badge">Stand-in schematic{isDev && ` / public/media/${render}`}</span>}
  </div>
</div>
{caption && <p class="t-mono soft cap wrap">{caption}</p>}
<style>
  .pin { height: 240vh; }
  .stage { position: sticky; top: var(--hdr); height: calc(100svh - var(--hdr)); }
  .fillbox { width: 100%; height: 100%; }
  .cap { padding-block: .6rem 0; }
  @media (prefers-reduced-motion: reduce) { .pin { height: auto; } .stage { position: relative; top: 0; height: 80vh; } }
</style>
