---
/**
 * Before/after with a divider. Slots "a" (revealed on the left) and "b" take anything:
 * images, videos or SVG. mode: "drag" | "follow" | "scroll".
 *   <Wipe labelA="One slice" labelB="Fused stack"> <Pic slot="a" .../> <Pic slot="b" .../> </Wipe>
 */
interface Props { labelA?: string; labelB?: string; mode?: 'drag' | 'follow' | 'scroll'; start?: number; ratio?: string; fill?: boolean; caption?: string; }
const { labelA, labelB, mode = 'drag', start = 0.5, ratio = '5/4', fill = false, caption } = Astro.props;
---
<figure class:list={['w', { fill }]}>
  <x-wipe {mode} start={start} style={`--p:${start * 100}%;${fill ? '' : `aspect-ratio:${ratio}`}`}>
    <div class="layer b"><slot name="b" /></div>
    <div class="layer a"><slot name="a" /></div>
    <div class="bar" role="slider" tabindex="0" aria-label="Comparison position" aria-valuemin="0" aria-valuemax="100" aria-valuenow={start * 100}>
      <span class="grip" aria-hidden="true">&#x25C2;&#x25B8;</span>
    </div>
    {labelA && <span class="t-label tag ta">{labelA}</span>}
    {labelB && <span class="t-label tag tb">{labelB}</span>}
  </x-wipe>
  {caption && <figcaption class="t-mono soft">{caption}</figcaption>}
</figure>
<script>import '../../scripts/wipe';</script>
<style>
  .w { margin: 0; min-width: 0; }
  .w.fill, .w.fill x-wipe { height: 100%; }
  x-wipe { display: block; position: relative; overflow: hidden; width: 100%; touch-action: pan-y; user-select: none; cursor: ew-resize; background: #0a0a0a; }
  .layer { position: absolute; inset: 0; }
  .layer.a { clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .layer :global(img), .layer :global(video), .layer :global(svg) { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .bar { position: absolute; top: 0; bottom: 0; left: var(--p); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px #0a0a0a; }
  .grip { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 34px; height: 34px; display: grid; place-items: center; background: #fff; color: #000; border: 2px solid #0a0a0a; font-size: 13px; letter-spacing: -.1em; }
  .tag { position: absolute; bottom: 10px; padding: .4em .55em; background: #0a0a0a; color: #fff; pointer-events: none; }
  .ta { left: 10px; } .tb { right: 10px; background: #fff; color: #0a0a0a; }
  figcaption { padding-top: .55rem; max-width: 70ch; }
</style>
