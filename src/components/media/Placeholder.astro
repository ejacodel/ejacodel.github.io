---
/**
 * Stands in for a file that doesn't exist yet. Drop the file at the listed path and this disappears.
 * In dev it shows the path and the shot brief. On the live site it only says the media is coming.
 */
import { isDev } from '../../lib/media';
interface Props { kind?: string; path?: string; brief?: string; ratio?: string; tall?: boolean; }
const { kind = 'Photo', path, brief, ratio = '4/3', tall = false } = Astro.props;
---
<div class:list={['ph', { tall }]} style={`aspect-ratio:${ratio}`} data-shot={isDev ? path : undefined}>
  <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  <span class="t-label">{kind}</span>
  {isDev && brief && <p class="brief">{brief}</p>}
  {isDev && path && <code>{path}</code>}
  {!isDev && <span class="t-label soon">Media in preparation</span>}
</div>
<style>
  .ph { position: relative; width: 100%; height: 100%; padding: clamp(14px, 1.6vw, 22px); display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; color: #0a0a0a; background: #aeaca7 url("/textures/concrete-light.webp"); overflow: hidden; }
  .ph.tall { min-height: 100%; aspect-ratio: auto !important; }
  .brief { font-size: .8125rem; line-height: 1.35; max-width: 44ch; font-weight: 500; }
  code { margin-top: auto; font: 500 .6875rem/1.3 var(--f-mono); background: var(--dev); padding: .15em .4em; overflow-wrap: anywhere; }
  .soon { margin-top: auto; }
  .c { position: absolute; width: 14px; height: 14px; border: 0 solid #0a0a0a; }
  .tl { top: 6px; left: 6px; border-width: 2px 0 0 2px; } .tr { top: 6px; right: 6px; border-width: 2px 2px 0 0; }
  .bl { bottom: 6px; left: 6px; border-width: 0 0 2px 2px; } .br { bottom: 6px; right: 6px; border-width: 0 2px 2px 0; }
</style>
